<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for API 31+.

  Policy: the DataStore preferences file that holds bookmarks, recents, and
  theme settings is device-local and intentionally excluded from both cloud
  backups and device-to-device transfers. Add new preference files here so
  backup behavior stays explicit instead of undefined-by-default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/material_reference.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/material_reference.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
