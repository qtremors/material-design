{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtremors.github.io/material-design/catalog.schema.json",
  "title": "Material Design Android working catalog",
  "type": "object",
  "required": ["schemaVersion", "material3Version", "stableBaseline", "reviewedOn", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "material3Version": { "type": "string" },
    "stableBaseline": { "type": "string" },
    "reviewedOn": { "type": "string", "format": "date" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "officialName", "aliases", "kind", "category", "summary", "collections", "demoKey", "sourceLocations", "apiReferences", "officialUrls", "implementation", "addedIn", "reviewedOn"]
      }
    }
  }
}
